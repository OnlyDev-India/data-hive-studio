{
  "collection": "orders",
  "stages": [
    {
      "stage": {
        "$match": {
          "_id": { "$oid": "507f1f77bcf86cd799439011" },
          "placed": { "$gte": { "$date": { "$numberLong": "1767225600000" } } },
          "status": { "$in": ["A", "B"] },
          "gift": false,
          "coupon": null
        }
      },
      "comments": ["Recent orders", "only status A or B"]
    },
    {
      "stage": {
        "$group": {
          "_id": "$customer",
          "total": { "$sum": { "$numberDecimal": "0.10" } },
          "big": { "$max": { "$numberLong": "9007199254740993" } },
          "ratio": { "$avg": { "$numberDouble": "2.0" } }
        }
      },
      "comments": []
    },
    { "stage": { "$limit": { "$numberLong": "10" } }, "comments": [] }
  ]
}
