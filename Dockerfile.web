# dh-studio web UI — built SPA served by nginx, proxying /v1 to the API.
#
# Build:  docker build -f Dockerfile.web -t dh-studio-web .
# (usually via docker compose up --build)

# ---- build stage -----------------------------------------------------------
FROM oven/bun:alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
# vite build --mode web → outputs dist-web/
RUN bun run build:web

# ---- runtime stage ---------------------------------------------------------
FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-web /usr/share/nginx/html

EXPOSE 80
